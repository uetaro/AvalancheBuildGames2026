# Avalanche 環境設定
# 本ファイルを .env にコピーして値を設定すること

# ネットワーク: mainnet | fuji（デフォルト: fuji）
AVALANCHE_NETWORK=fuji

# カスタム RPC URL（未設定時はネットワークのデフォルトを使用）
# Fuji: https://api.avax-test.network/ext/bc/C/rpc
# Mainnet: https://api.avax.network/ext/bc/C/rpc
# AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# 秘密鍵（0x プレフィックス付き）
# トランザクション送信時のみ必要。読み取り専用なら不要
# Fuji テストネット用のフォーセット: https://faucet.avax.network/
# AVALANCHE_PRIVATE_KEY=0x...
